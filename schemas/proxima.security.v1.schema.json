{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agataproxima.com/schemas/proxima.security.v1.schema.json",
  "title": "Proxima Security Policy v1",
  "description": "Database-neutral tenant-security policy contract. Database adapters compile these requirements into native controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "tenant_identity_claim",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "proxima.security.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_identity_claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "tenant_key",
          "operations"
        ],
        "properties": {
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "table",
                  "view",
                  "collection",
                  "procedure",
                  "function",
                  "keyspace"
                ]
              }
            }
          },
          "tenant_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "create",
                "update",
                "delete",
                "execute"
              ]
            }
          }
        }
      }
    }
  }
}
