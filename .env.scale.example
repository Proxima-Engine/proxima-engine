# Explicit high-concurrency profile. Use only on a host sized for the target.
# This is a per-Engine-process session limit, not a tenant-count limit.
PROXIMA_MAX_CONNECTIONS=50000
PROXIMA_PGBOUNCER_CONFIG=pgbouncer.scale.ini

# Provider gateway session caps are per Engine process. For the non-PostgreSQL
# passthrough gateways, each accepted client may also consume an upstream DB
# session; use these only when the provider/cluster is provisioned for it.
PROXIMA_MYSQL_MAX_CONNECTIONS=50000
PROXIMA_MONGODB_MAX_CONNECTIONS=50000
PROXIMA_REDIS_MAX_CONNECTIONS=50000
PROXIMA_SQLSERVER_TDS_MAX_CONNECTIONS=50000

# Keep tenant enforcement and TLS settings configured independently.
# Supply the real customer test secret through a secret manager; do not commit it.
PROXIMA_TENANT_SIGNING_KEY=
