# LOCAL DEVELOPMENT ONLY. Change passwords and secrets before any shared deployment.
POSTGRES_USER=proxima
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=appdb

# PgBouncer authenticates the local Engine upstream connection using
# pgbouncer-userlist.txt. If POSTGRES_PASSWORD changes, update the matching
# "proxima" password in that file as well.
#
# Empty disables tenant-token enforcement for the first connectivity run.
# For tenant-isolation testing, set a strong secret and follow
# docs/TENANT_ISOLATION.md.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_MAX_CONNECTIONS=128

# SQL Server TDS 7.4 gateway (host exposure defaults to loopback only)
PROXIMA_SQLSERVER_TDS_BIND_ADDRESS=127.0.0.1
PROXIMA_SQLSERVER_TDS_LISTEN_ADDR=0.0.0.0:14330
PROXIMA_SQLSERVER_TDS_ALLOW_NON_LOOPBACK=true

# Local gateway execution is the default for Docker Compose. Set this to
# "kubernetes" only when the shared-PVC gateway reconciler is deployed.
PROXIMA_GATEWAY_EXECUTION_MODE=local
PROXIMA_NODE_DATABASE_CONFIG_PATH=/var/lib/proxima/database-targets.json
PROXIMA_NODE_DATABASE_SECRETS_PATH=/var/lib/proxima/database-target-secrets.json
PROXIMA_NODE_GATEWAY_STATUS_PATH=/var/lib/proxima/gateway-runtime-status.json

# MySQL gateway client TLS. The certificate and private key are mounted from
# secrets/mysql-gateway-cert.pem and secrets/mysql-gateway-key.pem.
PROXIMA_MYSQL_BIND_ADDRESS=127.0.0.1
