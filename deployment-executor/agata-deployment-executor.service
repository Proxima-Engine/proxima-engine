[Unit]
Description=Agata Proxima customer-managed Engine deployment executor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=agata-deployer
Group=docker
WorkingDirectory=/opt/proxima
EnvironmentFile=/etc/agata/deployment-executor.env
ExecStart=/usr/bin/node /opt/proxima/deployment-executor/receiver.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agata-deployment-executor
UMask=0077

[Install]
WantedBy=multi-user.target
