# Engine container environment for the Cloud-managed Kubernetes gateway mode.
# Mount the same persistent volume at /var/lib/agata-proxima in the Engine pod
# and in the proxima-gateways controller pod.
PROXIMA_GATEWAY_EXECUTION_MODE=kubernetes
PROXIMA_NODE_DATABASE_CONFIG_PATH=/var/lib/agata-proxima/database-targets.json
PROXIMA_NODE_DATABASE_SECRETS_PATH=/var/lib/agata-proxima/database-target-secrets.json
PROXIMA_NODE_GATEWAY_STATUS_PATH=/var/lib/agata-proxima/gateway-runtime-status.json

# The Engine reads these source PEM files and publishes them as scoped
# Kubernetes Secrets through the reconciler. Do not put PEM contents in this file.
PROXIMA_SQLSERVER_TDS_UPSTREAM_CA_PEM=/run/secrets/sqlserver-tds-upstream-ca.pem
PROXIMA_SQLSERVER_TDS_CLIENT_CERT_PEM=/run/secrets/sqlserver-tds-client-cert.pem
PROXIMA_SQLSERVER_TDS_CLIENT_KEY_PEM=/run/secrets/sqlserver-tds-client-key.pem
PROXIMA_SQLSERVER_TDS_ALLOW_NON_LOOPBACK=true

PROXIMA_MYSQL_TLS_CERT_FILE=/run/secrets/mysql-gateway-cert.pem
PROXIMA_MYSQL_TLS_KEY_FILE=/run/secrets/mysql-gateway-key.pem
PROXIMA_MYSQL_UPSTREAM_TLS_CA_FILE=/run/secrets/mysql-upstream-ca.pem
PROXIMA_MONGODB_UPSTREAM_TLS_CA_FILE=/run/secrets/mongodb-upstream-ca.pem
PROXIMA_MONGODB_TLS_CERT_FILE=/run/secrets/mongodb-gateway-cert.pem
PROXIMA_MONGODB_TLS_KEY_FILE=/run/secrets/mongodb-gateway-key.pem
PROXIMA_REDIS_UPSTREAM_TLS_CA_FILE=/run/secrets/redis-upstream-ca.pem
PROXIMA_REDIS_TLS_CERT_FILE=/run/secrets/redis-gateway-cert.pem
PROXIMA_REDIS_TLS_KEY_FILE=/run/secrets/redis-gateway-key.pem
