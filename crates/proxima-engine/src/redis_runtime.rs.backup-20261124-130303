//! Cloud assignment activation for the restricted RESP2 Redis gateway.
//!
//! Activation provisions exact tenant key-pattern ACL users, verifies scoped
//! read/write and cross-prefix denial, removes revoked users, and supervises the
//! node-local RESP2 gateway over verified TLS.

use crate::{
    redis_gateway::RedisIdentityRegistry,
    runtime_activation::{GatewayProcessSpec, RuntimeProcessSupervisor},
    runtime_reconciliation::{self, RuntimePhase, RuntimeRecord},
    sqlserver_runtime::VerifiedBinding,
};
use rustls::{
    pki_types::{CertificateDer, ServerName},
    ClientConfig, RootCertStore,
};
use serde_json::Value;
use sha2::{Digest, Sha256};
use std::{
    collections::{HashMap, HashSet},
    fs::{self, File},
    io::{self, BufReader},
    net::SocketAddr,
    path::Path,
    time::Duration,
};
use tokio::{
    io::{AsyncReadExt, AsyncWriteExt},
    net::TcpStream,
    time::timeout,
};
use tokio_rustls::{client::TlsStream, TlsConnector};

#[derive(Clone)]
pub struct RedisRuntime {
    supervisor: RuntimeProcessSupervisor,
}

impl RedisRuntime {
    pub fn new() -> Self {
        Self {
            supervisor: RuntimeProcessSupervisor::new(),
        }
    }

    pub async fn is_running(&self, assignment_id: &str) -> bool {
        self.supervisor.is_running(assignment_id).await
    }

    pub async fn stop(&self, assignment_id: &str) -> io::Result<()> {
        self.supervisor.stop(assignment_id).await
    }

    pub async fn shutdown(&self) -> io::Result<()> {
        self.supervisor.stop_all().await
    }

    pub async fn activate(
        &self,
        assignment: &Value,
        credentials: &Value,
        executable_dir: &Path,
        private_root: &Path,
        state_path: &Path,
        state: &mut RuntimeRecord,
    ) -> Result<Vec<VerifiedBinding>, Box<dyn std::error::Error + Send + Sync>> {
        let assignment_id = required(assignment, "assignment_id")?;
        let provider = required(assignment, "provider_key")?;
        if provider != "redis" {
            return Err(invalid("Redis runtime cannot activate another provider").into());
        }
        if required(assignment, "cloud_integration_state")? != "enabled" {
            return Err(invalid("Redis assignment is not enabled for live integration").into());
        }
        if required(assignment, "gateway_runtime")? != "proxima-redis-gateway" {
            return Err(invalid("assignment does not select the Redis RESP2 gateway").into());
        }
        let runtime = credentials
            .get("gateway_runtime_config")
            .ok_or_else(|| invalid("gateway_runtime_config is required for Redis activation"))?;
        if runtime.get("schema_version").and_then(Value::as_u64) != Some(1)
            || runtime.get("provider_key").and_then(Value::as_str) != Some("redis")
        {
            return Err(invalid("Redis gateway runtime schema/provider mismatch").into());
        }
        let users = runtime
            .get("users")
            .and_then(Value::as_array)
            .ok_or_else(|| invalid("Redis runtime users must be an array"))?;
        validate_tenant_coverage(assignment, users)?;
        let bindings = assignment
            .get("tenant_bindings")
            .and_then(Value::as_array)
            .ok_or_else(|| invalid("Redis tenant_bindings are required"))?;
        let active_count = bindings
            .iter()
            .filter(|b| b.get("status").and_then(Value::as_str) != Some("revoked"))
            .count();
        if active_count != users.len() {
            return Err(invalid(
                "Redis runtime users must exactly cover non-revoked tenant bindings",
            )
            .into());
        }

        let listen: SocketAddr = runtime
            .get("listen_addr")
            .and_then(Value::as_str)
            .unwrap_or("127.0.0.1:6380")
            .parse()?;
        let kubernetes_mode =
            std::env::var("PROXIMA_GATEWAY_EXECUTION_MODE").as_deref() == Ok("kubernetes");
        if !kubernetes_mode && !listen.ip().is_loopback() {
            return Err(invalid("local Redis gateway must bind to loopback; use Kubernetes execution mode for pod networking").into());
        }
        let upstream_addr = required(runtime, "upstream_addr")?;
        let upstream_name = required(runtime, "upstream_tls_server_name")?;
        let ca_file = runtime
            .get("upstream_tls_ca_file")
            .and_then(Value::as_str)
            .map(str::to_owned)
            .or_else(|| std::env::var("PROXIMA_REDIS_UPSTREAM_TLS_CA_FILE").ok())
            .ok_or_else(|| invalid("Redis upstream TLS CA file is required"))?;
        let cert_file = runtime
            .get("tls_cert_file")
            .and_then(Value::as_str)
            .map(str::to_owned)
            .or_else(|| std::env::var("PROXIMA_REDIS_TLS_CERT_FILE").ok())
            .ok_or_else(|| invalid("Redis gateway TLS certificate is required"))?;
        let key_file = runtime
            .get("tls_key_file")
            .and_then(Value::as_str)
            .map(str::to_owned)
            .or_else(|| std::env::var("PROXIMA_REDIS_TLS_KEY_FILE").ok())
            .ok_or_else(|| invalid("Redis gateway TLS key is required"))?;
        for path in [&ca_file, &cert_file, &key_file] {
            if !Path::new(path).is_file() {
                return Err(invalid("Redis gateway TLS file is missing").into());
            }
        }
        let upstream_tls = runtime
            .get("upstream_tls")
            .and_then(Value::as_bool)
            .unwrap_or(true);
        if !upstream_tls {
            return Err(invalid("Cloud-managed Redis activation requires upstream TLS").into());
        }
        let admin_user = required(credentials, "username")?;
        let admin_password = required(credentials, "password")?;
        let desired_revision = state.desired_revision;
        let credential_revision = state.credential_revision;
        let needs_apply = state.phase != RuntimePhase::Applied
            || state.applied_revision != Some(desired_revision);
        let mut evidence = Vec::with_capacity(bindings.len());
        provision_upstream_acl(
            users,
            bindings,
            upstream_addr,
            upstream_name,
            &ca_file,
            admin_user,
            admin_password,
        )
        .await?;
        for binding in bindings {
            let status = binding
                .get("status")
                .and_then(Value::as_str)
                .unwrap_or_default();
            let details = if status == "revoked" {
                serde_json::json!({"acl_user":required(binding, "identity_reference")?,"revocation":"ACL DELUSER applied"})
            } else {
                let user = users
                    .iter()
                    .find(|u| {
                        u.get("tenant_id").and_then(Value::as_str)
                            == binding.get("tenant_id").and_then(Value::as_str)
                    })
                    .ok_or_else(|| invalid("Redis binding has no runtime user"))?;
                serde_json::json!({"acl_user":required(user, "upstream_username")?,"key_pattern":"tenant-scoped opaque prefix","upstream_tls":true,"acl_authentication_and_key_isolation_verified":true})
            };
            evidence.push(redis_binding_evidence(
                binding,
                assignment,
                if status == "revoked" {
                    "revoked"
                } else {
                    "active"
                },
                details,
            )?);
        }
        if users.is_empty() {
            self.stop(assignment_id).await?;
            if needs_apply {
                state.begin_apply(desired_revision, credential_revision)?;
                runtime_reconciliation::persist(state_path, state)?;
                state.mark_applied(desired_revision, true)?;
                runtime_reconciliation::persist(state_path, state)?;
            }
            return Ok(evidence);
        }
        let registry_json = serde_json::to_vec(runtime)?;
        let registry_path = private_root.join("gateway-identities").join(format!(
            "{}.json",
            hex::encode(Sha256::digest(assignment_id.as_bytes()))
        ));
        write_private_file(&registry_path, &registry_json)?;
        let registry = RedisIdentityRegistry::load(&registry_path)?;
        if registry.principal_count() != users.len() {
            return Err(invalid("Redis registry principal count mismatch").into());
        }
        if kubernetes_mode {
            probe_all_upstream_acl(users, upstream_addr, upstream_name, &ca_file).await?;
            if needs_apply {
                state.begin_apply(desired_revision, credential_revision)?;
                runtime_reconciliation::persist(state_path, state)?;
                state.mark_applied(desired_revision, true)?;
                runtime_reconciliation::persist(state_path, state)?;
            }
            return Ok(evidence);
        }

        if state.phase == RuntimePhase::Applied
            && state.applied_revision == Some(desired_revision)
            && self.is_running(assignment_id).await
        {
            probe_all_upstream_acl(users, upstream_addr, upstream_name, &ca_file).await?;
            return Ok(evidence);
        }
        if self.is_running(assignment_id).await {
            self.stop(assignment_id).await?;
        }
        let binary = executable_dir.join(format!(
            "proxima-redis-gateway{}",
            std::env::consts::EXE_SUFFIX
        ));
        if !binary.is_file() {
            return Err(
                invalid("proxima-redis-gateway binary is not packaged beside Engine").into(),
            );
        }
        state.begin_apply(desired_revision, credential_revision)?;
        runtime_reconciliation::persist(state_path, state)?;
        let spec = GatewayProcessSpec {
            assignment_id: assignment_id.to_owned(),
            executable: binary.to_string_lossy().into_owned(),
            args: Vec::new(),
            env: vec![
                ("PROXIMA_REDIS_LISTEN_ADDR".into(), listen.to_string()),
                (
                    "PROXIMA_REDIS_IDENTITY_REGISTRY".into(),
                    registry_path.to_string_lossy().into_owned(),
                ),
                (
                    "PROXIMA_REDIS_UPSTREAM_ADDR".into(),
                    upstream_addr.to_owned(),
                ),
                (
                    "PROXIMA_REDIS_UPSTREAM_TLS_SERVER_NAME".into(),
                    upstream_name.to_owned(),
                ),
                (
                    "PROXIMA_REDIS_UPSTREAM_TLS_CA_FILE".into(),
                    ca_file.to_owned(),
                ),
                ("PROXIMA_REDIS_TLS_CERT_FILE".into(), cert_file.to_owned()),
                ("PROXIMA_REDIS_TLS_KEY_FILE".into(), key_file.to_owned()),
                (
                    "PROXIMA_REDIS_MAX_CONNECTIONS".into(),
                    runtime
                        .get("max_connections")
                        .and_then(Value::as_u64)
                        .unwrap_or(128)
                        .to_string(),
                ),
                ("RUST_LOG".into(), "proxima_engine=info".into()),
            ],
            readiness_addr: listen,
            startup_timeout: Duration::from_secs(20),
        };
        if let Err(error) = self.supervisor.start(spec).await {
            state.mark_failed("REDIS_GATEWAY_START_FAILED")?;
            runtime_reconciliation::persist(state_path, state)?;
            return Err(Box::new(error));
        }
        if let Err(error) =
            probe_all_upstream_acl(users, upstream_addr, upstream_name, &ca_file).await
        {
            let _ = self.stop(assignment_id).await;
            state.mark_failed("REDIS_UPSTREAM_ACL_HEALTH_FAILED")?;
            runtime_reconciliation::persist(state_path, state)?;
            return Err(error);
        }
        state.mark_applied(desired_revision, true)?;
        runtime_reconciliation::persist(state_path, state)?;
        Ok(evidence)
    }
}
impl Default for RedisRuntime {
    fn default() -> Self {
        Self::new()
    }
}

fn validate_tenant_coverage(assignment: &Value, users: &[Value]) -> io::Result<()> {
    let bindings = assignment
        .get("tenant_bindings")
        .and_then(Value::as_array)
        .ok_or_else(|| invalid("tenant_bindings are required"))?;
    let active: Vec<&Value> = bindings
        .iter()
        .filter(|b| b.get("status").and_then(Value::as_str) != Some("revoked"))
        .collect();
    if active.len() != users.len() {
        return Err(invalid(
            "Redis principals must exactly cover non-revoked tenant bindings",
        ));
    }
    let mut expected = HashMap::new();
    for binding in bindings {
        let tenant = required(binding, "tenant_id")?;
        let namespace = required(binding, "namespace")?;
        let identity = required(binding, "identity_reference")?;
        if expected
            .insert(
                tenant.to_owned(),
                (namespace.to_owned(), identity.to_owned()),
            )
            .is_some()
        {
            return Err(invalid("duplicate Redis tenant binding"));
        }
        if !matches!(
            required(binding, "status")?,
            "pending" | "provisioning" | "active" | "revoked"
        ) {
            return Err(invalid(
                "Redis tenant binding has an unsupported lifecycle status",
            ));
        }
    }
    let mut seen = HashSet::new();
    let mut upstream_users = HashSet::new();
    for user in users {
        let tenant = required(user, "tenant_id")?;
        let username = required(user, "username")?;
        let upstream_user = required(user, "upstream_username")?;
        let hash = required(user, "client_password_sha256")?;
        let decoded = hex::decode(hash).map_err(|error| invalid(&error.to_string()))?;
        let expected_binding = expected
            .get(tenant)
            .ok_or_else(|| invalid("Redis user has no assigned tenant binding"))?;
        if decoded.len() != 32
            || !active
                .iter()
                .any(|b| b.get("tenant_id").and_then(Value::as_str) == Some(tenant))
            || !seen.insert(tenant.to_owned())
        {
            return Err(invalid(
                "Redis identity is malformed, duplicated or not assigned",
            ));
        }
        if username.len() > 128
            || upstream_user.len() > 128
            || username.bytes().any(|b| !b.is_ascii_graphic())
            || upstream_user.bytes().any(|b| !b.is_ascii_graphic())
        {
            return Err(invalid("Redis identity username is invalid"));
        }
        if upstream_user != expected_binding.1
            || expected_binding.0 != tenant
            || !upstream_users.insert(upstream_user.to_owned())
        {
            return Err(invalid("Redis ACL identity/namespace is duplicated or does not match the Cloud tenant binding"));
        }
        let upstream_password = required(user, "upstream_password")?;
        if upstream_password.len() < 24
            || upstream_password.len() > 256
            || !upstream_password.bytes().all(|b| (33..=126).contains(&b))
        {
            return Err(invalid(
                "Redis upstream password must contain 24-256 printable ASCII characters",
            ));
        }
    }
    let expected_active: HashSet<String> = active
        .iter()
        .map(|b| required(b, "tenant_id").map(str::to_owned))
        .collect::<io::Result<_>>()?;
    if seen != expected_active {
        return Err(invalid(
            "Redis principals do not exactly cover active tenant bindings",
        ));
    }
    Ok(())
}

async fn provision_upstream_acl(
    users: &[Value],
    bindings: &[Value],
    addr: &str,
    server_name: &str,
    ca_file: &str,
    admin_user: &str,
    admin_password: &str,
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let connector = TlsConnector::from(std::sync::Arc::new(client_tls(ca_file)?));
    let socket = timeout(Duration::from_secs(10), TcpStream::connect(addr)).await??;
    let name = ServerName::try_from(server_name.to_owned())
        .map_err(|error| invalid(&error.to_string()))?;
    let mut stream = timeout(Duration::from_secs(10), connector.connect(name, socket)).await??;
    redis_command(
        &mut stream,
        &[b"AUTH", admin_user.as_bytes(), admin_password.as_bytes()],
    )
    .await?;
    let auth = read_resp_line(&mut stream).await?;
    if auth != b"+OK\r\n" {
        return Err(invalid("Redis administrator ACL authentication failed").into());
    }
    for binding in bindings
        .iter()
        .filter(|b| b.get("status").and_then(Value::as_str) == Some("revoked"))
    {
        let username = required(binding, "identity_reference")?;
        redis_command(&mut stream, &[b"ACL", b"DELUSER", username.as_bytes()]).await?;
        let reply = read_resp_line(&mut stream).await?;
        if !reply.starts_with(b":") {
            return Err(invalid("Redis ACL DELUSER returned an invalid response").into());
        }
    }
    for user in users {
        let tenant_id = required(user, "tenant_id")?;
        let username = required(user, "upstream_username")?;
        let password = required(user, "upstream_password")?;
        let prefix = crate::redis_protocol::tenant_prefix(tenant_id)?;
        let pattern = [prefix.as_slice(), b"*"].concat();
        let rules: [&[u8]; 11] = [
            b"ACL",
            b"SETUSER",
            username.as_bytes(),
            b"reset",
            b"on",
            // Redis ACL's > token marks a password rule; no plaintext is logged.
            // The value remains inside the encrypted Cloud runtime envelope.
            b"+@read",
            b"+@write",
            b"-@admin",
            b"-@dangerous",
            b"-@connection",
            b"+PING",
        ];
        let mut command = rules.to_vec();
        let password_rule = format!(">{password}");
        command.insert(5, password_rule.as_bytes());
        command.insert(6, pattern.as_slice());
        redis_command(&mut stream, &command).await?;
        let reply = read_resp_line(&mut stream).await?;
        if reply != b"+OK\r\n" {
            return Err(invalid("Redis ACL SETUSER failed").into());
        }
    }
    Ok(())
}

async fn redis_command<S: tokio::io::AsyncWrite + Unpin>(
    stream: &mut S,
    args: &[&[u8]],
) -> io::Result<()> {
    let owned = args.iter().map(|arg| arg.to_vec()).collect::<Vec<_>>();
    let encoded = crate::redis_protocol::encode_command(&owned);
    stream.write_all(&encoded).await?;
    stream.flush().await
}

fn redis_binding_evidence(
    binding: &Value,
    assignment: &Value,
    status: &str,
    details: Value,
) -> io::Result<VerifiedBinding> {
    Ok(VerifiedBinding {
        provider_key: "redis".into(),
        binding_id: required(binding, "binding_id")?.to_owned(),
        target_id: required(assignment, "database_target_id")?.to_owned(),
        revision: assignment
            .get("config_revision")
            .and_then(Value::as_i64)
            .ok_or_else(|| invalid("Redis config revision missing"))?,
        tenant_id: required(binding, "tenant_id")?.to_owned(),
        identity_reference: required(binding, "identity_reference")?.to_owned(),
        database: required(binding, "namespace")?.to_owned(),
        status: status.to_owned(),
        details: if status == "active" {
            let mut verified = details.as_object().cloned().unwrap_or_default();
            verified.insert("identity_verified".into(), Value::Bool(true));
            verified.insert("isolation_verified".into(), Value::Bool(true));
            Value::Object(verified)
        } else {
            details
        },
    })
}

async fn probe_all_upstream_acl(
    users: &[Value],
    addr: &str,
    server_name: &str,
    ca_file: &str,
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let connector = TlsConnector::from(std::sync::Arc::new(client_tls(ca_file)?));
    for user in users {
        let upstream_user = required(user, "upstream_username")?;
        let password = required(user, "upstream_password")?;
        let socket = timeout(Duration::from_secs(10), TcpStream::connect(addr)).await??;
        let name = ServerName::try_from(server_name.to_owned())
            .map_err(|error| invalid(&error.to_string()))?;
        let mut stream: TlsStream<TcpStream> =
            timeout(Duration::from_secs(10), connector.connect(name, socket)).await??;
        let auth = format!(
            "*3\r\n$4\r\nAUTH\r\n${}\r\n{}\r\n${}\r\n{}\r\n",
            upstream_user.len(),
            upstream_user,
            password.len(),
            password
        );
        stream.write_all(auth.as_bytes()).await?;
        stream.flush().await?;
        let auth_reply = read_resp_line(&mut stream).await?;
        if auth_reply != b"+OK\r\n" {
            return Err(invalid("Redis upstream ACL authentication failed").into());
        }
        stream.write_all(b"*1\r\n$4\r\nPING\r\n").await?;
        stream.flush().await?;
        let ping_reply = read_resp_line(&mut stream).await?;
        if ping_reply != b"+PONG\r\n" {
            return Err(invalid("Redis upstream PING health check failed").into());
        }
        let tenant_id = required(user, "tenant_id")?;
        let prefix = crate::redis_protocol::tenant_prefix(tenant_id)?;
        let scoped_key = [prefix.as_slice(), b"__proxima_acl_probe"].concat();
        redis_command(&mut stream, &[b"SET", scoped_key.as_slice(), b"ok"]).await?;
        if read_resp_line(&mut stream).await? != b"+OK\r\n" {
            return Err(invalid("Redis tenant ACL could not write its scoped key").into());
        }
        redis_command(&mut stream, &[b"GET", scoped_key.as_slice()]).await?;
        let bulk_header = read_resp_line(&mut stream).await?;
        if bulk_header != b"$2\r\n" {
            return Err(invalid("Redis tenant ACL could not read its scoped key").into());
        }
        let mut bulk = [0u8; 4];
        stream.read_exact(&mut bulk).await?;
        if &bulk != b"ok\r\n" {
            return Err(invalid("Redis scoped key readback did not match").into());
        }
        redis_command(&mut stream, &[b"GET", b"__proxima_unscoped_probe"]).await?;
        let denied = read_resp_line(&mut stream).await?;
        if !denied.starts_with(b"-NOPERM") {
            return Err(invalid("Redis ACL did not deny an unscoped key").into());
        }
        redis_command(&mut stream, &[b"DEL", scoped_key.as_slice()]).await?;
        let _ = read_resp_line(&mut stream).await?;
    }
    Ok(())
}
async fn read_resp_line<S: tokio::io::AsyncRead + Unpin>(stream: &mut S) -> io::Result<Vec<u8>> {
    let mut out = Vec::with_capacity(128);
    while out.len() < 1024 {
        let mut byte = [0u8; 1];
        timeout(Duration::from_secs(10), stream.read_exact(&mut byte))
            .await
            .map_err(|_| {
                io::Error::new(io::ErrorKind::TimedOut, "Redis health probe timed out")
            })??;
        out.push(byte[0]);
        if out.ends_with(b"\r\n") {
            return Ok(out);
        }
    }
    Err(invalid("Redis health probe response exceeded limit"))
}
fn client_tls(ca: &str) -> io::Result<ClientConfig> {
    let mut roots = RootCertStore::empty();
    let certs = rustls_pemfile::certs(&mut BufReader::new(File::open(ca)?))
        .collect::<Result<Vec<CertificateDer<'static>>, _>>()
        .map_err(|error| invalid(&error.to_string()))?;
    if certs.is_empty() {
        return Err(invalid("Redis upstream CA bundle is empty"));
    }
    for cert in certs {
        roots
            .add(cert)
            .map_err(|error| invalid(&error.to_string()))?;
    }
    Ok(ClientConfig::builder()
        .with_root_certificates(roots)
        .with_no_client_auth())
}
fn required<'a>(value: &'a Value, key: &str) -> io::Result<&'a str> {
    value
        .get(key)
        .and_then(Value::as_str)
        .map(str::trim)
        .filter(|v| !v.is_empty())
        .ok_or_else(|| invalid(&format!("{key} is missing or empty")))
}
fn invalid(message: &str) -> io::Error {
    io::Error::new(io::ErrorKind::InvalidData, message.to_owned())
}
fn write_private_file(path: &Path, bytes: &[u8]) -> io::Result<()> {
    let parent = path
        .parent()
        .ok_or_else(|| invalid("identity path has no parent"))?;
    fs::create_dir_all(parent)?;
    set_private_directory(parent)?;
    let temporary = path.with_extension("json.tmp");
    if temporary.exists() {
        fs::remove_file(&temporary)?;
    }
    fs::write(&temporary, bytes)?;
    set_private_file(&temporary)?;
    if path.exists() {
        fs::remove_file(path)?;
    }
    fs::rename(&temporary, path)?;
    set_private_file(path)
}
#[cfg(unix)]
fn set_private_directory(path: &Path) -> io::Result<()> {
    use std::os::unix::fs::PermissionsExt;
    fs::set_permissions(path, fs::Permissions::from_mode(0o700))
}
#[cfg(unix)]
fn set_private_file(path: &Path) -> io::Result<()> {
    use std::os::unix::fs::PermissionsExt;
    fs::set_permissions(path, fs::Permissions::from_mode(0o600))
}
#[cfg(windows)]
fn set_private_directory(path: &Path) -> io::Result<()> {
    windows_acl(path, true)
}
#[cfg(windows)]
fn set_private_file(path: &Path) -> io::Result<()> {
    windows_acl(path, false)
}
#[cfg(windows)]
fn windows_acl(path: &Path, directory: bool) -> io::Result<()> {
    use std::process::Command;
    let output = Command::new("whoami.exe")
        .args(["/user", "/fo", "csv", "/nh"])
        .output()?;
    if !output.status.success() {
        return Err(io::Error::new(
            io::ErrorKind::PermissionDenied,
            "cannot resolve Windows service SID",
        ));
    }
    let sid = String::from_utf8_lossy(&output.stdout)
        .trim()
        .split(',')
        .nth(1)
        .map(|v| v.trim().trim_matches('"'))
        .filter(|v| v.starts_with("S-1-"))
        .ok_or_else(|| invalid("invalid Windows service SID"))?
        .to_owned();
    let current = if directory {
        format!("*{sid}:(OI)(CI)F")
    } else {
        format!("*{sid}:F")
    };
    let system = if directory {
        "*S-1-5-18:(OI)(CI)F"
    } else {
        "*S-1-5-18:F"
    };
    let admins = if directory {
        "*S-1-5-32-544:(OI)(CI)F"
    } else {
        "*S-1-5-32-544:F"
    };
    for args in [
        vec!["/reset".to_owned()],
        vec!["/inheritance:r".to_owned()],
        vec![
            "/grant:r".to_owned(),
            current,
            system.to_owned(),
            admins.to_owned(),
        ],
    ] {
        let result = Command::new("icacls.exe").arg(path).args(args).output()?;
        if !result.status.success() {
            return Err(io::Error::new(
                io::ErrorKind::PermissionDenied,
                "icacls failed while protecting Redis identity registry",
            ));
        }
    }
    Ok(())
}
#[cfg(not(any(unix, windows)))]
fn set_private_directory(_: &Path) -> io::Result<()> {
    Err(io::Error::new(
        io::ErrorKind::Unsupported,
        "secure identity storage unsupported",
    ))
}
#[cfg(not(any(unix, windows)))]
fn set_private_file(_: &Path) -> io::Result<()> {
    Err(io::Error::new(
        io::ErrorKind::Unsupported,
        "secure identity storage unsupported",
    ))
}

#[cfg(test)]
mod tests {
    use super::validate_tenant_coverage;
    use serde_json::json;
    #[test]
    fn redis_runtime_requires_exact_tenant_coverage() {
        let assignment = json!({"tenant_bindings":[{"tenant_id":"t1","status":"active"},{"tenant_id":"t2","status":"pending"}]});
        let users = vec![
            json!({"tenant_id":"t1","username":"a","upstream_username":"acl_a","client_password_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","upstream_password":"secret"}),
            json!({"tenant_id":"t2","username":"b","upstream_username":"acl_b","client_password_sha256":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","upstream_password":"secret"}),
        ];
        assert!(validate_tenant_coverage(&assignment, &users).is_ok());
        assert!(validate_tenant_coverage(&assignment, &users[..1]).is_err());
    }
    #[test]
    fn redis_runtime_rejects_duplicate_tenant_principals() {
        let assignment = json!({"tenant_bindings":[{"tenant_id":"t1","status":"active"}]});
        let user = json!({"tenant_id":"t1","username":"a","upstream_username":"acl_a","client_password_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","upstream_password":"secret"});
        assert!(validate_tenant_coverage(&assignment, &[user.clone(), user]).is_err());
    }
}
