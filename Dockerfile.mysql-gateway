FROM rust:1.88-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --release -p proxima-mysql-gateway --bin proxima-mysql-gateway

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/proxima-mysql-gateway /usr/local/bin/proxima-mysql-gateway
USER 65532:65532
EXPOSE 13306
ENTRYPOINT ["/usr/local/bin/proxima-mysql-gateway"]
